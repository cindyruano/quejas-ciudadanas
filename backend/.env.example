# ==========================================================
#  Configuración del backend - copia este archivo como .env
# ==========================================================

# Puerto donde escucha la API
PORT=3000

# Orígenes permitidos por CORS (separados por coma). Live Server usa el 5500.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Tamaño máximo de la fotografía en MB
MAX_FILE_MB=5

# Categorías válidas de quejas (separadas por coma). El frontend las consulta desde la API.
CATEGORIAS=Alumbrado público,Baches y calles,Recolección de basura,Agua y drenaje,Seguridad,Parques y áreas verdes,Ruido,Otro

# ---------------- Firebase (Cloud Firestore) ----------------
# OPCIÓN PRODUCCIÓN (Render u otro hosting): el JSON completo de la cuenta de servicio codificado en Base64
FIREBASE_SERVICE_ACCOUNT_BASE64=

# OPCIÓN A (recomendada en local): ruta al JSON de la cuenta de servicio descargado desde Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# OPCIÓN B: credenciales individuales (deja vacía la opción A si usas esta)
# La clave privada va entre comillas y con los saltos de línea como \n
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Nombres de las colecciones en Firestore
FIRESTORE_COLLECTION_QUEJAS=quejas
FIRESTORE_COLLECTION_IMAGENES=imagenes
FIRESTORE_COLLECTION_CAPTURAS=capturas
